# IaaS Platform Environment Variables
#
# Copy this file to .env and fill in the values for your local development.
# This file is in .gitignore and will not be committed to version control.

# =============================================================================
# General Settings
# =============================================================================
APP_ENV=development
LOG_LEVEL=DEBUG

# =============================================================================
# API Gateway Settings
# =============================================================================
API_GATEWAY_PORT=8000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# =============================================================================
# Database Settings
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iaas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iaas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# Redis Settings
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# Message Queue Settings (RabbitMQ)
# =============================================================================
MESSAGE_QUEUE_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# =============================================================================
# Control Plane Settings
# =============================================================================
CONTROL_PLANE_PORT=8001
CONTROL_PLANE_URL=http://localhost:8001

# =============================================================================
# Failover Manager Settings
# =============================================================================
FAILOVER_MANAGER_PORT=8002
CHECK_INTERVAL_SECONDS=30
FAILOVER_THRESHOLD=3

# =============================================================================
# Provider Settings
# =============================================================================

# Hetzner Cloud
HETZNER_API_TOKEN=your-hetzner-api-token
HETZNER_API_URL=https://api.hetzner.cloud/v1
PROVIDER_HETZNER_ENABLED=true

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
PROVIDER_AWS_ENABLED=false

# DigitalOcean
DIGITALOCEAN_API_TOKEN=your-digitalocean-api-token
DIGITALOCEAN_API_URL=https://api.digitalocean.com/v2
PROVIDER_DIGITALOCEAN_ENABLED=false

# =============================================================================
# Object Storage (MinIO)
# =============================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False

# =============================================================================
# Monitoring Settings
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# =============================================================================
# Web UI Settings
# =============================================================================
WEB_UI_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# Security Settings
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-for-encryption
ENCRYPTION_SALT=your-encryption-salt

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# =============================================================================
# CORS Settings
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
