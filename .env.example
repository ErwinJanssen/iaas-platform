# IaaS Platform Environment Variables
# Hybrid Architecture - Uses existing tools (Crossplane, NATS, etc.)
#
# Copy this file to .env and fill in the values for your local development.
# This file is in .gitignore and will not be committed to version control.

# =============================================================================
# General Settings
# =============================================================================
APP_ENV=development
LOG_LEVEL=DEBUG
ARCHITECTURE=hybrid

# =============================================================================
# API Gateway Settings
# =============================================================================
API_GATEWAY_PORT=8000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# =============================================================================
# Control Plane Settings
# =============================================================================
CONTROL_PLANE_PORT=8001
CONTROL_PLANE_URL=http://control-plane:8001

# =============================================================================
# Failover Manager Settings
# =============================================================================
FAILOVER_MANAGER_PORT=8002
FAILOVER_MANAGER_URL=http://failover-manager:8002
CHECK_INTERVAL_SECONDS=30
FAILOVER_THRESHOLD=3

# =============================================================================
# Database Settings (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/iaas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iaas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# =============================================================================
# Redis Settings
# =============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# NATS Settings (replaces RabbitMQ)
# =============================================================================
NATS_URL=nats://nats:4222
NATS_HOST=nats
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# =============================================================================
# MinIO Settings (Object Storage)
# =============================================================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_BUCKET=iaas

# =============================================================================
# Crossplane Settings
# =============================================================================
# For local development without Kubernetes, use the mock
CROSSPLANE_API_URL=http://crossplane-mock:8080
CROSSPLANE_IN_CLUSTER=false

# For production with Kubernetes
# CROSSPLANE_API_URL=https://crossplane-api:9443
# CROSSPLANE_IN_CLUSTER=true

# =============================================================================
# Provider Settings
# =============================================================================

# Hetzner Cloud (primary provider)
HETZNER_API_TOKEN=your-hetzner-api-token
HETZNER_API_URL=https://api.hetzner.cloud/v1
PROVIDER_HETZNER_ENABLED=true

# AWS (secondary provider)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
PROVIDER_AWS_ENABLED=false

# DigitalOcean (tertiary provider)
DIGITALOCEAN_API_TOKEN=your-digitalocean-api-token
DIGITALOCEAN_API_URL=https://api.digitalocean.com/v2
PROVIDER_DIGITALOCEAN_ENABLED=false

# =============================================================================
# Monitoring Settings
# =============================================================================
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_PORT=3001
GRAFANA_URL=http://grafana:3000

# =============================================================================
# Security Settings
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-for-encryption
ENCRYPTION_SALT=your-encryption-salt

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# =============================================================================
# CORS Settings
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# =============================================================================
# Kubernetes Settings (for Crossplane in production)
# =============================================================================
K8S_NAMESPACE=iaas-platform
K8S_CONFIG_PATH=~/.kube/config
